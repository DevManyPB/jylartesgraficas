# Copia este archivo a apps/web/.env.local y apps/panel/.env.local y rellena
# los valores desde la consola de Firebase. Los .env.local no se commitean.

# --- Firebase, cliente ---------------------------------------------------
# Van al navegador: no son secretos, los protege firestore.rules.
# No hay STORAGE_BUCKET a propósito: no se usa Firebase Storage (SPEC.md §2.2).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Único interruptor: en true, cliente y servidor hablan con los emuladores
# locales en vez del proyecto real. Desarrollo y pruebas van siempre así
# (AGENTS.md §4). El servidor deriva de aquí sus propias variables de
# emulador, así que no hay que configurarlas aparte.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true

# --- Firebase, servidor (cuenta de servicio) -----------------------------
# Secreto. Nunca con prefijo NEXT_PUBLIC_ ni en el código.
# La clave privada va entre comillas y con los saltos de línea como \n.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Cloudinary (Chunk F, aún sin usar) ----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (correo, Fase 2) ---------------------------------------------
RESEND_API_KEY=

# --- Revalidación (panel → sitio) -----------------------------------------
# Mismo valor en apps/web y apps/panel. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDACION_SECRETO=
# Solo en apps/panel: la URL del sitio público.
SITIO_URL=http://localhost:3000
